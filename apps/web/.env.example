# Copy to .env.local for local development.
#
# Leave VITE_API_BASE_URL empty for demo mode (data stays in the browser).
# Set it to use the real API (docker compose up → http://localhost:8000).
VITE_API_BASE_URL=http://localhost:8000

# "dev" = local sign-in (API must run with ENV=dev). Use "entra" in production.
VITE_AUTH_MODE=dev

# Entra External ID (only when VITE_AUTH_MODE=entra) — see docs/deploy-azure.md
VITE_ENTRA_CLIENT_ID=
VITE_ENTRA_AUTHORITY=https://<subdomain>.ciamlogin.com/
VITE_ENTRA_API_SCOPE=api://<api-client-id>/access_as_user
